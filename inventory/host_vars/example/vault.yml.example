---
# ==============================================================================
# Per-host secrets schema (inventory/host_vars/example/vault.yml.example)
# ==============================================================================
# Preferred: `make host-init HOST=<hostname>` copies and encrypts this schema
# into inventory/host_vars/<hostname>/vault.yml, then edit it with
# `make vault-edit HOST=<hostname>`. To do it by hand instead:
#
#   cp inventory/host_vars/example/vault.yml.example \
#      inventory/host_vars/<hostname>/vault.yml
#   ansible-vault encrypt inventory/host_vars/<hostname>/vault.yml
#
# The real vault.yml is gitignored and NEVER committed (even encrypted). It is the
# control-authoritative secrets file: user-supplied values plus control-generated
# values passed TO the host (the crypto keys and the owner/ansible passwords).
# Secrets returned BY the host (the admin PAT and setup-key secrets) live in the
# sibling vault_managed.yml. The vault password is read from
# ~/.config/projects/netbird-iac/ansible_vault_password (see ansible.cfg;
# `make vault-init` creates one).
# ==============================================================================

# --- Topology (single host; referenced from inventory/hosts.yml) --------------
vault_host:
  ip: "203.0.113.10"
  port: 22

# --- SSH connection identity -------------------------------------------------
# `make host-bootstrap` probes [ansible, admin, root] and uses the first that
# works; normal runs always use `ansible`. Each identity may set a password
# and/or a private key file (SSH prefers the key, then the password). There are
# no become/sudo-password vars: the ansible account gets NOPASSWD sudo.
#
# vault_*_ssh_privkey_file is the control-node private key for that identity.
# vault_*_ssh_pubkey_file is an optional control-node path to the matching public
# key; when set, `make host-bootstrap` authorizes it for that account. Empty is
# ignored (nothing is generated). Only paths, never raw key strings.
vault_root_password: ""
vault_root_ssh_privkey_file: "~/.ssh/id_ed25519"
vault_root_ssh_pubkey_file: ""
vault_admin_user: "admin"
vault_admin_password: ""
vault_admin_ssh_privkey_file: ""
vault_admin_ssh_pubkey_file: ""
# The ansible identity is the service account host-bootstrap creates/repairs;
# its public key (when set) also switches the account to key auth instead of a
# generated password.
vault_ansible_user: "ansible"
vault_ansible_password: ""
vault_ansible_ssh_privkey_file: "~/.ssh/id_ed25519_ansible"
vault_ansible_ssh_pubkey_file: ""

# --- Public endpoint ---------------------------------------------------------
vault_domain_name: "netbird.example.com"
vault_letsencrypt_email: "admin@example.com"

# --- Optional first-owner bootstrap ------------------------------------------
# The owner is a local user; the email must be valid (it need not match the
# deployment domain). Set it to auto-create the first owner via /api/setup; leave
# it empty to onboard manually at https://<domain>/setup. The password is
# optional: leave it empty to generate one into this file. A password
# without an email is ignored with a warning.
vault_owner_email: ""
vault_owner_name: ""
vault_owner_password: ""

# --- Tenant config-as-code access token --------------------------------------
# Personal Access Token of the 'admin' service user, used by playbooks/tenant.yml.
# On a fresh deploy it is created automatically by the first-owner bootstrap and
# written to vault_managed.yml (leave this empty).
vault_admin_service_user_access_token: ""

# ==============================================================================
# Host-returned secrets (written to vault_managed.yml; do not set them here)
# ==============================================================================
# Generated BY the NetBird host and returned to the control node:
#   vault_admin_service_user_access_token   'admin' service-user PAT (expires;
#                                           recreate it from the Dashboard)
#   vault_setup_key_<name>                  per new setup key (returned only at
#                                           creation; '_' replaces non-alphanumerics)
# Existing non-empty values are preserved (never rotated).
#
# Also managed automatically when left empty here, but kept IN THIS FILE (they are
# control-generated inputs passed to the host):
#   vault_datastore_encryption_key          at-rest data encryption key
#   vault_session_cookie_encryption_key     session cookie encryption key
#   vault_relay_auth_secret                 relay auth secret (base64)
#   vault_owner_password                    first owner password
#   vault_ansible_password                  service account password (only when
#                                           no public key is given)
# Ownership is disjoint: a key lives in exactly one file. Back up BOTH files:
# losing vault_datastore_encryption_key makes the encrypted user data unrecoverable.
