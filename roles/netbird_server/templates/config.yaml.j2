# ==============================================================================
# Combined NetBird Server Configuration
# Rendered by the netbird_server Ansible role. Do NOT edit on the target host;
# change roles/netbird_server/templates/config.yaml.j2 and redeploy.
# ==============================================================================
server:
  listenAddress: ":80"
  exposedAddress: "{{ netbird_http_protocol }}://{{ netbird_domain }}:{{ netbird_exposed_port }}"
  stunPorts:
    - {{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "{{ netbird_log_level }}"
  logFile: "console"

  # Skip the GeoLite2 DB download at startup (needs outbound access to
  # pkgs.netbird.io; disabling turns off geo-based posture checks).
  disableGeoliteUpdate: {{ 'true' if netbird_disable_geolite_update | bool else 'false' }}

  # Relay auth secret. Padding is stripped to match the upstream quickstart
  # script's expectation for this value.
  authSecret: "{{ vault_relay_auth_secret | replace('=', '') }}"
  dataDir: "/var/lib/netbird"

  auth:
    # Embedded IdP (Dex): local users by default; external OIDC providers can be
    # added later from the Dashboard without touching this file.
    issuer: "{{ netbird_http_protocol }}://{{ netbird_domain }}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "{{ vault_session_cookie_encryption_key }}"
    dashboardRedirectURIs:
      - "{{ netbird_http_protocol }}://{{ netbird_domain }}/nb-auth"
      - "{{ netbird_http_protocol }}://{{ netbird_domain }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "{{ netbird_traefik_ip }}/32"
{% if netbird_trusted_peers | length > 0 %}
    trustedPeers:
{% for peer in netbird_trusted_peers %}
      - "{{ peer }}"
{% endfor %}
{% endif %}

  store:
    engine: "sqlite"
    # Must keep base64 padding for Go's base64.StdEncoding. Losing this key makes
    # encrypted user data unrecoverable — back it up with vault_managed.yml.
    encryptionKey: "{{ vault_datastore_encryption_key }}"
