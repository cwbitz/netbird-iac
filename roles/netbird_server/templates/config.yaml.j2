# ==============================================================================
# Combined NetBird Server Configuration
# Rendered by the netbird_server Ansible role. Do NOT edit on the target host;
# change roles/netbird_server/templates/config.yaml.j2 and redeploy.
# ==============================================================================
server:
  listenAddress: ":80"
  exposedAddress: "{{ http_protocol }}://{{ domain_name }}:{{ exposed_port }}"
  stunPorts:
    - {{ stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "{{ log_level }}"
  logFile: "console"

  # GeoLite2 DB download at startup (needs pkgs.netbird.io; disabling turns off
  # geo-based posture checks).
  disableGeoliteUpdate: {{ 'true' if disable_geolite_update | bool else 'false' }}

  # Relay auth secret (base64 padding stripped, matching the quickstart).
  authSecret: "{{ vault_relay_auth_secret | replace('=', '') }}"
  dataDir: "/var/lib/netbird"

  auth:
    # Embedded Dex IdP: local users by default. Add external OIDC providers from
    # the Dashboard; this file does not need to change.
    issuer: "{{ http_protocol }}://{{ domain_name }}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "{{ vault_session_cookie_encryption_key }}"
    dashboardRedirectURIs:
      - "{{ http_protocol }}://{{ domain_name }}/nb-auth"
      - "{{ http_protocol }}://{{ domain_name }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "{{ traefik_ip }}/32"
{% if trusted_peers | length > 0 %}
    trustedPeers:
{% for peer in trusted_peers %}
      - "{{ peer }}"
{% endfor %}
{% endif %}

  store:
    engine: "sqlite"
    # Must keep base64 padding (Go base64.StdEncoding). Losing this key makes
    # encrypted user data unrecoverable — keep vault_managed.yml safe.
    encryptionKey: "{{ vault_datastore_encryption_key }}"
